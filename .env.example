# Arquivo de variáveis de ambiente para produção
# COPIE este arquivo como ".env" e preencha os valores
# NUNCA envie o arquivo .env para o GitHub!

# ── OBRIGATÓRIO: Troque por uma chave longa e aleatória ──────────────────────
# Gere uma: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

# ── Banco de dados ────────────────────────────────────────────────────────────
# Railway preenche automaticamente — não precisa alterar
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Pasta de uploads (Railway usa /tmp) ──────────────────────────────────────
# UPLOAD_FOLDER=/tmp/uploads

# ── Ambiente ──────────────────────────────────────────────────────────────────
FLASK_ENV=production
